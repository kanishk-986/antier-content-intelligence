# Variable NAMES ONLY. Never commit real values (blueprint 7.2, 33).
# Copy to .env, fill in, and chmod 600 .env

# --- LLM ---
# OPTIONAL. The default backend is the `claude` CLI, which authenticates against a
# Claude.ai subscription and bills no API credits (see docs/RUNBOOK.md). Set a key
# only if you want `--backend api`.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# Optional model override for the CLI backend; blank uses the CLI default.
# CLAUDE_CLI_MODEL=

# --- Storage ---
# SQLite for the vertical slice; swap to the Postgres URL when pg_store lands.
DATABASE_URL=sqlite:///data/aci.db
# DATABASE_URL=postgresql://user:password@localhost:5432/antier_content_intelligence

# --- Source registry ---
# Live Google Sheet behind the source registry. Shared read-only by link.
DISCOVERY_SHEET_ID=15gkGfWOWQvvYmHN2rCHskeyvgp6neB1p8pIRn9bD3Fg

# --- Runtime ---
LOG_LEVEL=INFO
RUN_WINDOW_HOURS=48

# Daily brief delivery (scripts/run_daily.py). Google Workspace SMTP.
# Create a 16-character app password at https://myaccount.google.com/apppasswords
# — your normal password will not work with 2FA enabled. Names only in this file;
# the real values go in .env, which is gitignored. chmod 600 .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
